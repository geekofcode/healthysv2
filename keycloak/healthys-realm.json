{
  "realm": "healthys",
  "displayName": "HEALTH’YS",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "defaultRoles": [
    "patient"
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administration globale HEALTH’YS"
      },
      {
        "name": "comptable",
        "description": "Finances et relevés financiers"
      },
      {
        "name": "gestionnaire",
        "description": "Lecture des informations de son établissement"
      },
      {
        "name": "hopital",
        "description": "Administration de son établissement"
      },
      {
        "name": "laboratoire",
        "description": "Analyses et résultats"
      },
      {
        "name": "medecin",
        "description": "Activités médicales"
      },
      {
        "name": "nurse",
        "description": "Soins et suivi infirmier"
      },
      {
        "name": "patient",
        "description": "Espace patient"
      }
    ]
  },
  "clients": [
    {
      "clientId": "healthys-backend-apps",
      "name": "HEALTHYS API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "healthys-web-apps",
      "name": "HEALTHYS Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email",
        "healthys-patient-profile"
      ],
      "protocolMappers": [
        {
          "name": "healthys-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "healthys-backend-apps",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "healthys-organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "healthys_organization_id",
            "claim.name": "healthys_organization_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "healthys-mobile-apps",
      "name": "HEALTHYS Mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "healthys://oauth/callback",
        "com.healthys.app:/oauthredirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "acr",
        "roles",
        "profile",
        "email",
        "healthys-patient-profile"
      ],
      "protocolMappers": [
        {
          "name": "healthys-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "healthys-backend-apps",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "healthys-organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "healthys_organization_id",
            "claim.name": "healthys_organization_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "loginTheme": "healthys",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "clientScopes": [
    {
      "name": "healthys-patient-profile",
      "description": "HEALTH’YS identity fields for account provisioning",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "healthys-middleName",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "middleName",
            "claim.name": "middle_name",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "healthys-birthDate",
          "protocol": "openid-connect",
