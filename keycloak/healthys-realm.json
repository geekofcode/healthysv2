{
  "realm": "healthys",
  "displayName": "HEALTHYS",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "defaultRoles": ["PATIENT"],
  "roles": {
    "realm": [
      {"name": "PATIENT", "description": "Patient HEALTHYS"},
      {"name": "DOCTOR", "description": "Médecin"},
      {"name": "NURSE", "description": "Infirmier ou infirmière"},
      {"name": "HOSPITAL_ADMIN", "description": "Administrateur d'établissement"},
      {"name": "HOSPITAL_AGENT", "description": "Agent d'établissement"},
      {"name": "PHARMACIST", "description": "Pharmacien"},
      {"name": "LAB_TECHNICIAN", "description": "Personnel de laboratoire"},
      {"name": "CASHIER", "description": "Caissier ou caissière"},
      {"name": "ACCOUNTANT", "description": "Comptable"},
      {"name": "PLATFORM_ADMIN", "description": "Administrateur de la plateforme"}
    ]
  },
  "clients": [
    {
      "clientId": "healthys-backend-apps",
      "name": "HEALTHYS API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "healthys-web-apps",
      "name": "HEALTHYS Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "healthys-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "healthys-backend-apps",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "healthys-organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "healthys_organization_id",
            "claim.name": "healthys_organization_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "healthys-mobile-apps",
      "name": "HEALTHYS Mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "healthys://oauth/callback",
        "com.healthys.app:/oauthredirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "healthys-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "healthys-backend-apps",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "healthys-organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "healthys_organization_id",
            "claim.name": "healthys_organization_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
