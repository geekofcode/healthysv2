      "displayName": "${healthys.country}",
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      },
      "multivalued": false,
      "group": "contact",
      "validations": {
        "pattern": {
          "pattern": "^[A-Z]{2}$",
          "error-message": "healthys.country.invalid"
        }
      },
      "annotations": {
        "inputTypeMaxLength": 2
      }
    },
    {
      "name": "healthys_organization_id",
      "displayName": "Organization ID",
      "permissions": {
        "view": [
          "admin"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "validations": {
        "length": {
          "max": 36
        }
      }
    }
