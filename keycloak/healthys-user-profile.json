          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      },
      "multivalued": false,
      "group": "contact",
      "validations": {
        "length": {
          "max": 255
        }
      }
    },
    {
      "name": "addressLine2",
      "displayName": "${healthys.addressLine2}",
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      },
      "multivalued": false,
      "group": "contact",
      "validations": {
        "length": {
          "max": 255
        }
      }
    },
    {
      "name": "city",
      "displayName": "${healthys.city}",
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      },
      "multivalued": false,
      "group": "contact",
      "validations": {
        "length": {
          "max": 150
        }
      }
    },
    {
      "name": "region",
      "displayName": "${healthys.region}",
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      },
      "multivalued": false,
      "group": "contact",
      "validations": {
        "length": {
          "max": 150
        }
      }
    },
    {
      "name": "postalCode",
      "displayName": "${healthys.postalCode}",
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      },
      "multivalued": false,
      "group": "contact",
      "validations": {
        "length": {
          "max": 30
        }
      }
    },
    {
