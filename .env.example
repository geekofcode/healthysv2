# Copy this file to .env and replace every "replace-me" value.
# .env is ignored by Git and must never be committed.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Remote PostgreSQL
# Use a JDBC URL, never an http:// URL.
DB_URL=jdbc:postgresql://82.112.253.226:5432/healthys
DB_USERNAME=replace-me
DB_PASSWORD=replace-me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Flyway runs the versioned SQL migrations when the application starts.
# Set to false only when migrations are managed by the deployment pipeline.
FLYWAY_ENABLED=true

# Remote Keycloak (replace the realm if it is not named "healthys").
KEYCLOAK_ISSUER_URI=https://keycloak.wouri.tv/realms/healthys
KEYCLOAK_AUDIENCE=healthys-backend-apps
KEYCLOAK_API_CLIENT_ID=healthys-backend-apps
VITE_KEYCLOAK_URL=https://keycloak.wouri.tv
VITE_KEYCLOAK_REALM=healthys
VITE_KEYCLOAK_CLIENT_ID=healthys-web-apps

# Comma-separated frontend origins. Never use "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_MAX_AGE_SECONDS=3600

# Remote MinIO or another S3-compatible service.
STORAGE_ENDPOINT=https://minio.example.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=healthys
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
STORAGE_PATH_STYLE_ACCESS=true

# LiveKit server credentials. The API secret is backend-only and must never use a VITE_ prefix.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_TOKEN_TTL_MINUTES=5

# Firebase Cloud Messaging HTTP v1; upload APNs authentication key in Firebase for iOS.
PUSH_ENABLED=false
FCM_PROJECT_ID=healthys-63579014
# Absolute path to a mounted service account secret, never commit credentials.
FCM_SERVICE_ACCOUNT_FILE=
PUSH_POLL_INTERVAL_MS=10000

# Dedicated confidential Keycloak service account; keep disabled until configured.
PROFESSIONAL_ROLE_SYNC_ENABLED=false
KEYCLOAK_ADMIN_SERVER_URL=https://keycloak.wouri.tv
KEYCLOAK_ADMIN_REALM=healthys
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
PROFESSIONAL_ROLE_SYNC_POLL_INTERVAL_MS=10000

# Stripe subscriptions: HEALTHYS platform account only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=http://localhost:3000/licensing

# Patient access and care policies (ISO-8601 durations).
PATIENT_ACCESS_REQUEST_DURATION=PT48H
PATIENT_ACCESS_EMERGENCY_DURATION=PT1H
PATIENT_ACCESS_SCHEDULED_GRACE=PT1H
CARE_FOLLOW_UP_DURATION=PT168H
DATA_RETENTION_YEARS=30

# Default slot for explicit availability; recurring schedules keep their own slot duration.
CARE_VISIT_SLOT_MINUTES=30

# Bounded clinical access for an ongoing encounter that extends beyond episode coverage.
CARE_IN_PROGRESS_ACCESS_DURATION=PT4H

# Optional private AI service: docker compose --profile ai up --build.
# Keep disabled until the private service and a suitable OpenAI project are configured.
HEALTHYS_AI_ENABLED=false
HEALTHYS_AI_SERVICE_URL=http://ai:8000
HEALTHYS_AI_SERVICE_TOKEN=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
HEALTHYS_AI_TIMEOUT=PT60S
AI_TIMEOUT_SECONDS=50
HEALTHYS_AI_JOB_DEADLINE=PT15M
HEALTHYS_AI_AUDIO_TTL=PT1H
HEALTHYS_AI_MAX_ATTEMPTS=3
HEALTHYS_AI_POLL_INTERVAL_MS=5000
HEALTHYS_AI_AUDIO_SWEEP_INTERVAL_MS=60000
AI_MAX_AUDIO_BYTES=10485760
AI_MAX_SNAPSHOT_BYTES=180000
AI_MAX_NOTES_CHARS=30000
AI_MAX_OUTPUT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=6000
AI_MAX_CONCURRENCY=4
SCHEDULING_POOL_SIZE=4
