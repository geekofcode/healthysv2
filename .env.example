# Copy this file to .env for local development only.
COMPOSE_PROJECT_NAME=healthys

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local-change-me
POSTGRES_DB=postgres

HEALTHYS_DB_NAME=healthys
HEALTHYS_DB_USER=healthys
HEALTHYS_DB_PASSWORD=healthys-local-change-me

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.4
KEYCLOAK_PORT=8081
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-local-change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-change-me

MINIO_IMAGE=minio/minio:RELEASE.2025-10-15T17-29-55Z
MINIO_MC_IMAGE=minio/mc:latest
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=healthys
MINIO_ROOT_PASSWORD=minio-local-change-me
MINIO_BUCKET=healthys

# Spring Boot local profile (also contains safe local defaults)
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/healthys
DB_USERNAME=healthys
DB_PASSWORD=healthys-local-change-me
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/healthys
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=healthys
STORAGE_ACCESS_KEY=healthys
STORAGE_SECRET_KEY=minio-local-change-me
STORAGE_PATH_STYLE_ACCESS=true

# Staging/production examples (inject real secrets in the deployment platform):
# DB_URL=jdbc:postgresql://82.112.253.226:5432/healthys
# KEYCLOAK_ISSUER_URI=https://keycloak.wouri.tv/realms/healthys
# STORAGE_ENDPOINT=https://minio.example.com
